# Local AI (recommended)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180

# Optional legacy cloud provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
GROQ_MODEL_CANDIDATES=llama-3.1-70b-versatile,llama-3.1-8b-instant,mixtral-8x7b-32768,gemma2-9b-it

# Auth
JWT_SECRET=
JWT_EXP_MINUTES=43200

# CORS
CORS_ORIGINS=*

# Postgres (alternative: set DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=NORA
DB_USER=postgres
DB_PASSWORD=

# Or use a full SQLAlchemy URL
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/astra_coach

# RAG
RAG_COLLECTION_NAME=nora_rag_docs
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
